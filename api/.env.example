# PostgreSQL kapcsolat
DB_HOST=localhost
DB_PORT=5432
DB_NAME=familycollection
DB_USER=familyuser
DB_PASS=CHANGE_ME

# Külső metadata-szolgáltatások
ISBNDB_KEY=

# Metadata-szolgáltatók engedélyezése
USE_ISBNDB=false
USE_OPENLIBRARY=true
USE_ISBNSEARCH=true

# Alkalmazási környezet
APP_ENV=development

# Külön pytest adatbázis
TEST_DATABASE_URL=postgresql+psycopg2://familyuser:CHANGE_ME@localhost:5432/familycollection_test
