# PostgreSQL connection
# DB_PORT is the PostgreSQL port published on the host.
# On a fresh installation, the installer automatically selects
# an available port when necessary.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=familycollection
DB_USER=familyuser
DB_PASS=CHANGE_ME

# External metadata services
ISBNDB_KEY=

# Metadata providers
USE_ISBNDB=false
USE_OPENLIBRARY=true
USE_ISBNSEARCH=true

# Application environment
APP_ENV=development

# Dedicated pytest database
TEST_DATABASE_NAME=familycollection_test

# Login session
SESSION_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=2592000

# URL subpath support
# Root deployment:
#   APP_BASE_PATH=
#   SESSION_COOKIE_PATH=/
#
# Reverse proxy / subpath deployment example:
#   APP_BASE_PATH=/familycollection
#   SESSION_COOKIE_PATH=/familycollection
#
# APP_BASE_PATH is used by the web UI when the application is published
# under a URL prefix. SESSION_COOKIE_PATH should normally match it so the
# session cookie is isolated to the application path.
APP_BASE_PATH=
SESSION_COOKIE_PATH=/
