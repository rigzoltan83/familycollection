# PostgreSQL kapcsolat
# DB_PORT a hoston publikált PostgreSQL port.
# Fresh install esetén az installer automatikusan szabad portot választ.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=familycollection
DB_USER=familyuser
DB_PASS=CHANGE_ME

# Külső metadata-szolgáltatások
ISBNDB_KEY=

# Metadata-szolgáltatók engedélyezése
USE_ISBNDB=false
USE_OPENLIBRARY=true
USE_ISBNSEARCH=true

# Alkalmazási környezet
APP_ENV=development

# Külön pytest adatbázis
TEST_DATABASE_NAME=familycollection_test

# Bejelentkezási session

SESSION_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=2592000

# URL subpath support
#
# Root deployment:
#   APP_BASE_PATH=
#   SESSION_COOKIE_PATH=/
#
# Reverse proxy / subpath deployment example:
#   APP_BASE_PATH=/familycollection
#   SESSION_COOKIE_PATH=/familycollection
#
# APP_BASE_PATH is used by the web UI when the application is published
# under a URL prefix. SESSION_COOKIE_PATH should normally match it so the
# session cookie is isolated to the application path.
APP_BASE_PATH=
SESSION_COOKIE_PATH=/
